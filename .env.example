# =============================================================================
# BUSSIGO: Environment Configuration Template (MOCK / SANDBOX ONLY)
# Zero real secrets, passwords, or production credentials permitted.
# =============================================================================

# Application Environment (Development | Staging | Production)
BUSSIGO_ENV=Development

# Simulation & Telemetry Configuration (Synthetic / Localhost)
TELEMETRY_ENABLED=true
TELEMETRY_ENDPOINT=http://127.0.0.1:8080/v1/telemetry
MOCK_STORE_ENABLED=true

# Local Debug Options
ENABLE_DEV_CONSOLE=true
ENABLE_PHYSICS_OVERLAY=true
LOG_LEVEL=Debug

# Geographic Data Provider Mode (OfflineSynthetic | OpenDataLocal)
GEO_DATA_PROVIDER=OfflineSynthetic
MAP_TILE_CACHE_DIR=./Cache/MapTiles
